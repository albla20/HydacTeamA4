@startuml DesignClassDiagram
title Design Class Diagram (Larman) - HYDAC Check-in/Check-out System

hide circle
skinparam classAttributeIconSize 0
hide emptymembers

class CheckInSystem {
  + checkInEmployee(id: String) : void
  + checkOutEmployee(id: String) : void
  + showPresent() : List<Person>
  + createEmployee(name: String, department: String) : Employee
  + editEmployee(id: String, name: String, department: String) : void
  + registerGuest(name: String, company: String, host: Employee) : Guest
  + checkOutGuest(name: String) : void
  + markSafetyFolderHandedOut(name: String) : void
  + searchPerson(name: String) : Person
}

class Employee {
  - employeeID : String
  - department : String
  - username : String
  - name : String
  - arrivalTime : DateTime
  - departureTime : DateTime
  + <<get>> IsAdmin : boolean
  + CheckInGuest() : void
  + CheckOutGuest() : void
  + IsPresent() : boolean
  + GetStatus() : String
  + LogIn() : boolean
  + CreateEmployee(name: String, department: String) : void
  + EditEmployee(name: String, department: String) : void
  + IsHostFor(guest: Guest) : boolean
}

class Guest {
  - company : String
  - safetyFolderHandedOut : boolean
  - name : String
  - arrivalTime : DateTime
  - departureTime : DateTime
  + CheckIn() : void
  + CheckOut() : void
  + IsPresent() : boolean
  + GetStatus() : String
  + MarkSafetyFolderHandedOut() : void
  + GetHost() : Employee
}

CheckInSystem "1" -- "0..*" Employee : manages
CheckInSystem "1" -- "0..*" Guest : manages

@enduml
