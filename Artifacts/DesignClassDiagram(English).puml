@startuml DesignClassDiagram
title Design Class Diagram (Larman) - HYDAC Check-in/Check-out System

hide circle
skinparam classAttributeIconSize 0
hide emptymembers

class CheckInSystem {
  + checkInEmployee(id: String) : void
  + checkOutEmployee(id: String) : void
  + showPresent() : List<Person>
  + createEmployee(name: String, department: String) : Employee
  + editEmployee(id: String, name: String, department: String) : void
  + registerGuest(name: String, company: String, host: Employee) : Guest
  + checkOutGuest(name: String) : void
  + markSafetyFolderHandedOut(name: String) : void
  + searchPerson(name: String) : Person
}

class Employee {
  - employeeID : String
  - department : String
  - username : String
  - name : String
  - arrivalTime : DateTime
  - departureTime : DateTime
  - status : String
  + checkIn() : void
  + checkOut() : void
  + isPresent() : boolean
  + getStatus() : String
  + logIn() : boolean
  + createMasterData(name: String, department: String) : void
  + editMasterData(name: String, department: String) : void
  + isHostFor(guest: Guest) : boolean
}

class Guest {
  - company : String
  - safetyFolderHandedOut : boolean
  - name : String
  - arrivalTime : DateTime
  - departureTime : DateTime
  - status : String
  + checkIn() : void
  + checkOut() : void
  + isPresent() : boolean
  + getStatus() : String
  + markSafetyFolderHandedOut() : void
  + getHost() : Employee
}

class Administrator {
  + userName : String
  + password : String
  + login() : boolean
}
CheckInSystem "1" -- "0..*" Administrator : manages
CheckInSystem "1" -- "0..*" Employee : manages
CheckInSystem "1" -- "0..*" Guest : manages





@enduml
